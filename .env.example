# ── Django ────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here-change-this
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=BE.settings.local
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# ── Database: local profile ───────────────────────────────────────────
# 로컬에서는 DATABASE_URL만 사용합니다. AWS에서 DB_*를 사용할 때는
# Elastic Beanstalk의 DATABASE_URL 환경 속성을 비워두거나 삭제하세요.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/culturepick

# ── AWS profile ───────────────────────────────────────────────────────
# AWS에서는 아래 DB_*를 환경 속성으로 설정하고 DATABASE_URL은 설정하지 않습니다.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
AWS_STORAGE_BUCKET_NAME=culturepick-community-images-241732001230-ap-northeast-2-an
AWS_S3_REGION_NAME=ap-northeast-2
AWS_S3_CUSTOM_DOMAIN=culturepick-community-images-241732001230-ap-northeast-2-an.s3.ap-northeast-2.amazonaws.com
# Prefer Elastic Beanstalk EC2 IAM Role credentials in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
COMMUNITY_ALLOWED_IMAGE_HOSTS=culturepick-community-images-241732001230-ap-northeast-2-an.s3.ap-northeast-2.amazonaws.com

# ── Redis / Celery ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/0
CACHE_KEY_PREFIX=culturepick-cache
# Local direct access is 0. The current direct ALB -> EB production path is 1.
DRF_NUM_PROXIES=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db
CELERY_ENABLE_KOPIS_BEAT_SCHEDULE=False
CELERY_WORKER_ENABLE_REMOTE_CONTROL=False
CELERY_REDIS_GLOBAL_KEYPREFIX={culturepick-celery}:
CELERY_REDIS_RESULT_GLOBAL_KEYPREFIX={culturepick-celery-result}:
LOG_RAW_RETENTION_DAYS=90
LOG_RETENTION_BATCH_SIZE=1000

# ── KOPIS API ─────────────────────────────────────────────────────────
KOPIS_API_KEY=your-kopis-api-key
KOPIS_ONGOING_SYNC_DAYS=30
KOPIS_UPCOMING_SYNC_DAYS=60
KOPIS_SYNC_LOCK_TTL_SECONDS=7200

# ── 소셜 로그인 ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 이메일 / 계정 복구 ────────────────────────────────────────────
# 로컬은 console backend를 사용하므로 SMTP 값이 없어도 됩니다.
# 운영에서는 AWS SES SMTP 또는 사용하는 메일 서비스 값을 설정하세요.
DEFAULT_FROM_EMAIL=noreply@culturepick.net
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
FRONTEND_PASSWORD_RESET_URL=https://culturepick.netlify.app/find-account
FRONTEND_LOGIN_URL=https://culturepick.netlify.app/login
PASSWORD_RESET_TIMEOUT=3600
PASSWORD_RESET_REQUEST_THROTTLE_RATE=5/hour
PASSWORD_RESET_CONFIRM_THROTTLE_RATE=10/hour
ACCOUNT_RECOVERY_THROTTLE_RATE=5/hour

# ── OpenAI ───────────────────────────────────────────────────────
AI_RECOMMENDATION_PROVIDER=openai
AI_RECOMMENDATION_MAX_OUTPUT_TOKENS=1200
AI_RECOMMENDATION_TEMPERATURE=0.35
AI_RECOMMENDATION_CANDIDATE_LIMIT_DEFAULT=12
AI_RECOMMENDATION_DEMO_INTENT_ENABLED=True
OPENAI_API_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_RECOMMENDATION_MODEL=gpt-4o-mini
GMS_API_KEY=
GMS_OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_RECOMMENDATION_MODEL=gpt-4.1


# ── CORS (운영 환경) ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://culturepick.com
CSRF_TRUSTED_ORIGINS=https://culturepick.com

