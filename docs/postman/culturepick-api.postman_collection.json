                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"performance_id\": \"{{performance_id}}\",\n  \"feedback_type\": \"click\",\n  \"metadata\": {\n    \"source\": \"postman\"\n  }\n}"
            },
            "url": "{{base_url}}/api/v1/recommendations/{{session_id}}/feedback/"
          }
        }
      ]
