    {
      "name": "Performances",
      "item": [
        {
          "name": "List / Search Performances",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "const first = (data.searchData && data.searchData[0]) || (data.results && data.results[0]);",
                  "if (first && first.performance_id) pm.environment.set('performance_id', first.performance_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/performances/?keyword=&genre=&local=&status=&pageNum=1&pageSize=20&sorted=latest",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "performances",
                ""
              ],
              "query": [
                {
                  "key": "keyword",
                  "value": ""
                },
                {
                  "key": "genre",
                  "value": ""
                },
                {
                  "key": "local",
                  "value": ""
                },
                {
                  "key": "status",
                  "value": ""
                },
                {
                  "key": "pageNum",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                },
                {
                  "key": "sorted",
                  "value": "latest"
                }
              ]
            }
          }
        },
        {
          "name": "Performance Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/performances/{{performance_id}}/"
          }
        },
        {
          "name": "Toggle Interest",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action_type\": \"interest\"\n}"
            },
            "url": "{{base_url}}/api/v1/performances/{{performance_id}}/actions/"
          }
        },
        {
          "name": "Set Watchlist",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
